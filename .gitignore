# Database credentials -- never commit real connection details
webapp/WEB-INF/classes/db.properties

# Compiled classes (regenerated by the build/compile step)
webapp/WEB-INF/classes/com/

# Uploaded user photos (user data, not source)
webapp/WEB-INF/uploads/*
!webapp/WEB-INF/uploads/.gitkeep

# OS / editor cruft
.DS_Store
*.swp

# Tomcat work/log output if a Tomcat instance is ever placed inside the repo
work/
logs/
*.log
